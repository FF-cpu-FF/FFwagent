# =============================================================================
#  Kopiere diese Datei nach .env und trage deine Werte ein.
#  .env steht in .gitignore und wird nie eingecheckt.
#  In GitHub Actions gehören dieselben Werte unter
#  Settings > Secrets and variables > Actions.
# =============================================================================

# --- Speicherorte ---
DATENBANK_URL=sqlite:///data/wohnungen.db
PROFIL_PFAD=config/suchprofil.yml
EXPORT_PFAD=docs/data/listings.json

# --- KI-Bewertung (optional) -------------------------------------------------
# Der einzige Teil des Agenten, der LLM-Tokens verbraucht. Standardmäßig aus.
# Selbst mit hinterlegtem Schlüssel passiert nichts, solange du nicht
# --mit-ki setzt bzw. im Dashboard "mit KI" ankreuzt.
# Genau einer der beiden Schlüssel genügt.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# LLM_MODELL=claude-sonnet-4-6

# --- ImmobilienScout24 (optional) --------------------------------------------
# Mit gültigem Partner-API-Schlüssel nutzt der Agent die offizielle
# Schnittstelle statt HTML und ist von robots.txt nicht betroffen.
IS24_API_KEY=

# --- Benachrichtigungen ------------------------------------------------------
# Jeder Kanal aktiviert sich, sobald seine Werte vollständig gesetzt sind.
# Telegram ist am schnellsten eingerichtet: @BotFather anschreiben, /newbot,
# dann dem Bot einmal selbst schreiben und die chat_id unter
# https://api.telegram.org/bot<TOKEN>/getUpdates ablesen.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# --- Verhalten ---------------------------------------------------------------
# Nur Treffer ab diesem Score werden gemeldet. 0 = alles melden.
MINDESTSCORE_MELDUNG=0
# Adressen über Nominatim in echte Koordinaten auflösen. Genauer, aber
# langsam (1 Anfrage/Sekunde) und nur sinnvoll, wenn Portale Straßen liefern.
GEOCODING_AKTIV=false
